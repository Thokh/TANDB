{
  "name": "instagram-live-checker",
  "version": "1.0.0",
  "description": "Mini app check live tài khoản Instagram và lượt theo dõi thời gian thực",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "./dist"
  },
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/InstaCheck.exe"
  },
  "keywords": [
    "instagram",
    "checker",
    "followers",
    "live-die-checker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "https-proxy-agent": "^5.0.1",
    "node-fetch": "^2.7.0"
  }
}
